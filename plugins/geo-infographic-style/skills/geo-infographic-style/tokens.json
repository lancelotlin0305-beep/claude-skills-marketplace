    "fillRatio": { "value": 0.75, "ref": "§3.1 留白判準②" },
    "fillRatioDistributionBand": { "value": 0.55, "ref": "§3.1 例外②分佈帶" },
    "contrastOnDark": { "value": 4.5, "ref": "§2 表面分類" },
    "minBodyPx": { "value": 16, "ref": "§6.2 下限不是目標" },
    "minAnyPx": { "value": 14.5, "ref": "§6.2" },
    "typeDeviationPct": { "value": 10, "ref": "§6.4 偏離 10% 視為整組跑掉" },
    "clearanceChildToFrame": { "value": 12, "ref": "§3.1" },
    "clearanceInlineSiblings": { "value": 20, "ref": "§3.1" },
    "clearanceFlowNode": { "value": 40, "ref": "§4" },
    "clearanceArrow": { "value": 6, "ref": "§4" },
    "maxAssetsPerPage": { "value": 8, "ref": "deck-anatomy L3" },
    "minAssetDisplayPx": { "value": 40, "ref": "deck-anatomy L3:小於此尺寸不放 3D 件" },
    "cardItemsMin": { "value": 2, "ref": "SKILL 每卡 2–5 條" },
    "cardItemsMax": { "value": 5, "ref": "SKILL 每卡 2–5 條" }
  },

  "pageChrome": {
