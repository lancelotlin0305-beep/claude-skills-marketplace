        "foot": 1.4, "big": 6.5, "bigUnit": 2.8
      },
      "type": {
        "title": 56, "lead": 32, "conclude": 38, "cardTitle": 26, "tile": 24,
        "subCard": 22, "sub": 20, "body": 22, "note": 20, "pill": 20,
        "foot": 15, "big": 70, "bigUnit": 30
      }
    },
    "a4": {
      "label": "A4 直式報告",
      "viewing": "紙本 40cm",
      "canvas": { "w": 1240, "h": 1754 },
      "anchor": "pt",
      "pxPerPt": 2.08,
      "k": 1.0,
      "pt": {
        "title": 24, "lead": 14, "conclude": 14, "cardTitle": 13, "tile": 12,
        "subCard": 11, "sub": 11, "body": 10.5, "note": 10, "pill": 9.5,
        "foot": 8, "big": 30, "bigUnit": 13
      },
      "type": {
        "title": 50, "lead": 29, "conclude": 29, "cardTitle": 27, "tile": 25,
        "subCard": 23, "sub": 23, "body": 22, "note": 21, "pill": 20,
        "foot": 17, "big": 62, "bigUnit": 27
      }
    }
  },

  "weights": {
    "title": 900, "lead": 800, "conclude": 800, "cardTitle": 800, "tile": 800,
    "subCard": 700, "sub": 500, "body": 500, "note": 400, "pill": 700,
    "foot": 400, "big": 900, "bigUnit": 700
  },

  "font": {
    "family": "'Noto Sans TC','Microsoft JhengHei','Noto Sans CJK TC',sans-serif",
    "cjkWidthRatio": 1.0,
    "asciiWidthRatio": 0.55,
    "asciiBoldWidthRatio": 0.63,
    "capHeightRatio": 0.88,
    "lineHeightRatio": 1.55,
    "unbreakable": "英文/數字/代號詞視為不可分割單元,自動斷行須以詞為界"
  },

  "geometry": {
    "_note": "基準值(16:9 / 1920x1080);換模式乘 k。",
    "margin": 60,
    "radius": { "card": 16, "subCard": 12, "band": 14, "tile": 16, "pillFull": -1, "pillBox": 16 },
    "padding": { "cardX": 24, "cardY": 22, "pillX": 24, "bandX": 24, "rightMin": 16, "rightMax": 40 },
    "gap": {
      "band": 20, "col": 24, "row": 12,
      "childToFrame": 12, "inlineSiblings": 20, "titleToChild": 14,
      "flowNode": 40, "arrowClear": 6, "arrowLane": 50
    },
    "badgeRadius": { "hub": 28, "band": 24, "kpi": 18, "inlineIcon": 21 },
    "arrow": { "len": 44, "shaft": 16, "head": 30 },
    "connector": {
      "flowWidth": 2.6, "dotRadius": 4.5, "parallelClear": 14,
      "radialDash": "2 6", "radialWidth": 2, "axisDash": "0.1 13", "axisWidth": 5
    },
    "pedestal": {
      "_note": "hub 多層實體台座(geox-navy §5)",
      "tiers": [
        { "rx": 212, "ry": 34, "thickness": 0, "kind": "glow" },
        { "rx": 180, "ry": 28, "thickness": 12, "kind": "solid" },
        { "rx": 146, "ry": 24, "thickness": 10, "kind": "solid" }
      ]
    },
    "cylinder": { "ryRatio": 0.215, "pillWidthRatioOfBody": 0.86, "pillGap": 8, "pillHeight": 58, "pillRadius": 16 }
  },

  "shadows": {
    "_note": "視覺常數,不套 k。",
    "shadow": [{ "dy": 9, "blur": 12, "opacity": 0.14 }, { "dy": 2, "blur": 3, "opacity": 0.1 }],
    "card2": [{ "dy": 4, "blur": 5, "opacity": 0.13 }],
    "row": [{ "dy": 2, "blur": 2, "opacity": 0.1 }],
    "hdr": [{ "dy": 3, "blur": 3, "opacity": 0.26 }],
    "obj": [{ "dy": 4, "blur": 4, "opacity": 0.28 }],
    "thicknessEdge": { "dy": 6, "opacity": 0.16 }
  },

  "stroke": { "card": 2, "subCard": 1.5, "hairline": 1, "divider": 1.5, "glowRim": 1.6 },

